GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
QDRANT_URL=
QDRANT_API_KEY=
# Blank uses in-process Qdrant. Use http://localhost:6333 for Docker.
CLAIMGUARD_HOME=.
# API/MCP corpus; Streamlit has its own corpus selector.
CLAIMGUARD_CORPUS=drip_r
# Generate a long random value. API refuses protected requests when unset.
CLAIMGUARD_API_TOKEN=
